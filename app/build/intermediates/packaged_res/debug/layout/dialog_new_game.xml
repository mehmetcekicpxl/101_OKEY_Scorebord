<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/rounded_card_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/new_game"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/gold_accent"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etHostName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/host_name"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/white"
        android:backgroundTint="@color/okey_green_light"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oyuncular"
        android:textColor="@color/okey_green_light"
        android:textSize="12sp"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etPlayer1Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/player_1"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/white"
        android:backgroundTint="@color/text_secondary"
        android:layout_marginTop="8dp"/>

    <EditText
        android:id="@+id/etPlayer2Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/player_2"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/white"
        android:backgroundTint="@color/text_secondary" />

    <EditText
        android:id="@+id/etPlayer3Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/player_3"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/white"
        android:backgroundTint="@color/text_secondary" />

    <EditText
        android:id="@+id/etPlayer4Name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/player_4"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/white"
        android:backgroundTint="@color/text_secondary" />

</LinearLayout>
